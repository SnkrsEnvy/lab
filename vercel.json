{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "gg39-share-v11/**", "use": "@vercel/static" },
    { "src": "gg39-share-v12/**", "use": "@vercel/static" },
    { "src": "broadcast-gateway/index.html", "use": "@vercel/static" },
    { "src": "broadcast-gateway/styles.css", "use": "@vercel/static" },
    { "src": "broadcast-gateway/app.js", "use": "@vercel/static" },
    { "src": "broadcast/index.html", "use": "@vercel/static" },
    { "src": "broadcast/39/index.html", "use": "@vercel/static" }
  ],
  "headers": [
    {"source": "/gg39-share-v12/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large"}]},
    {"source": "/broadcast/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large"}]},
    {"source": "/broadcast-gateway/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]}
  ]
}
